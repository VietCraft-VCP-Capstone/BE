# ============================================================
# VIETCRAFT BACKEND CORE - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================

# Server Port & Mode
PORT=8080
NODE_ENV=production

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your_production_jwt_secret_here_min_32_characters

# Databases
# PostgreSQL (Cloud: Neon.tech / Supabase / AWS RDS)
DATABASE_URL=postgresql://vietcraft_user:your_password@your_pg_host:5432/vietcraft_db
# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@vietcraft.eupxy2t.mongodb.net/?appName=VietCraft
# Redis (Cloud: Upstash / Redis Cloud / Internal)
REDIS_URL=redis://your_redis_host:6379

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Analytics Service
AI_ANALYTICS_URL=http://vietcraft-ai-analytics:8000
# Bí mật dùng chung với service AI, phải TRÙNG AI_GATEWAY_SECRET bên vc-ai/AI-Analysic.
AI_GATEWAY_SECRET=your_shared_gateway_secret_min_32_characters
# Để TRỐNG (mặc định): mỗi seller xem số liệu của chính gian hàng mình.
# Điền một mã shop dữ liệu mồi (ví dụ shp_00017): mọi seller xem số của shop mẫu đó và
# giao diện hiện nhãn "đang xem gian hàng mẫu". Chỉ dùng khi cần demo đủ 16 màn hình.
AI_DEMO_SHOP_ID=
# Ánh xạ RIÊNG từng người bán sang một shop mẫu: `email=shop,email2=shop2`.
# Dùng khi một account cần xem đủ 16 màn hình để demo, mà không bật shop mẫu cho cả nhóm.
# Ưu tiên cao hơn AI_DEMO_SHOP_ID. Giao diện vẫn hiện nhãn "đang xem gian hàng mẫu".
AI_SHOP_MAP=
# Quá thời gian này thì coi service AI lỗi (SRS MSG132: > 5 giây là lỗi).
AI_TIMEOUT_MS=5000

# Email (SMTP Nodemailer)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# Public Frontend URL (Used for CORS and email redirects)
FRONTEND_URL=https://yourdomain.com

# Cloudinary Storage
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_CLOUD_NAME=your_cloud_name

# SpeedSMS (Optional)
SPEEDSMS_ACCESS_TOKEN=your_speedsms_token
SPEEDSMS_SMS_TYPE=2

# VNPay Payment Gateway
VNP_TMNCODE=your_vnpay_tmn_code
VNP_HASHSECRET=your_vnpay_hash_secret
VNP_RETURNURL=https://yourdomain.com/orders/vnpay-return

# Refund workflow
REFUND_WINDOW_SECONDS=300
REFUND_MAX_ATTEMPTS=3
REFUND_MODE=PAYOUT
PAYOS_PAYOUT_TIMEOUT_SECONDS=900
# Tuỳ chọn: tài khoản nhận tiền của nền tảng. Buyer nhập trùng sẽ bị chặn (dest_is_merchant).
MERCHANT_BANK_BIN=
MERCHANT_ACCOUNT_NO=

# payOS collection credentials (dùng khi marketplace chuyển payment sang payOS)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_BASE_URL=https://api-merchant.payos.vn

# payOS payout credentials cho refund tự động
PAYOS_PAYOUT_CLIENT_ID=your_payos_payout_client_id
PAYOS_PAYOUT_API_KEY=your_payos_payout_api_key
PAYOS_PAYOUT_CHECKSUM_KEY=your_payos_payout_checksum_key
PAYOS_PAYOUT_BASE_URL=https://api-merchant.payos.vn
# Secret riêng do mình đặt để giảm request rác vào webhook; state vẫn luôn được poll lại từ payOS.
PAYOS_PAYOUT_WEBHOOK_SECRET=your_random_webhook_secret
STUB_PAYOS=false

# ============================================================
# PRINTING SHOP CONNECTION (Fulfillment & Webhook)
# ============================================================
PRINTER_ENV=production
# URL of the Printing Shop Backend (e.g. https://api-printer.yourdomain.com or internal docker: http://printing-shop-backend:8880)
PRINTER_API_URL=https://api-printer.yourdomain.com
# Shared API key for outbound order dispatch (Must match PRINTING_SHOP_API_KEY in Printing Shop backend)
PRINTER_API_KEY=your_shared_printing_shop_api_key_2026
# Shared secret for inbound webhook verification (Must match PRINTING_WEBHOOK_SECRET in Printing Shop backend)
PRINTER_WEBHOOK_SECRET=your_shared_printing_webhook_hmac_secret_2026
