# ============================================================
# VIETCRAFT BACKEND CORE - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================

# Server Port & Mode
PORT=8080
NODE_ENV=production

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your_production_jwt_secret_here_min_32_characters

# Databases
# PostgreSQL (Cloud: Neon.tech / Supabase / AWS RDS)
DATABASE_URL=postgresql://vietcraft_user:your_password@your_pg_host:5432/vietcraft_db
# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@vietcraft.eupxy2t.mongodb.net/?appName=VietCraft
# Redis (Cloud: Upstash / Redis Cloud / Internal)
REDIS_URL=redis://your_redis_host:6379

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Analytics Service
AI_ANALYTICS_URL=http://vietcraft-ai-analytics:8000

# Email (SMTP Nodemailer)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# Public Frontend URL (Used for CORS and email redirects)
FRONTEND_URL=https://yourdomain.com

# Cloudinary Storage
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_CLOUD_NAME=your_cloud_name

# SpeedSMS (Optional)
SPEEDSMS_ACCESS_TOKEN=your_speedsms_token
SPEEDSMS_SMS_TYPE=2

# VNPay Payment Gateway
VNP_TMNCODE=your_vnpay_tmn_code
VNP_HASHSECRET=your_vnpay_hash_secret
VNP_RETURNURL=https://yourdomain.com/orders/vnpay-return

# ============================================================
# PRINTING SHOP CONNECTION (Fulfillment & Webhook)
# ============================================================
PRINTER_ENV=production
# URL of the Printing Shop Backend (e.g. https://api-printer.yourdomain.com or internal docker: http://printing-shop-backend:8880)
PRINTER_API_URL=https://api-printer.yourdomain.com
# Shared API key for outbound order dispatch (Must match PRINTING_SHOP_API_KEY in Printing Shop backend)
PRINTER_API_KEY=your_shared_printing_shop_api_key_2026
# Shared secret for inbound webhook verification (Must match PRINTING_WEBHOOK_SECRET in Printing Shop backend)
PRINTER_WEBHOOK_SECRET=your_shared_printing_webhook_hmac_secret_2026
